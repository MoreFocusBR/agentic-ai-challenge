    {
      "parameters": {
        "name": "gerar_pdf",
        "description": "Gera um documento PDF com título e conteúdo fornecidos. Use quando o usuário solicitar explicitamente a criação de um relatório ou documento em PDF.",
        "method": "POST",
        "url": "http://app:8000/generate-pdf",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "title",
              "value": "={{ $fromAI('title', 'Título do documento PDF') }}"
            },
            {
              "name": "content",
              "value": "={{ $fromAI('content', 'Conteúdo completo do documento') }}"
            }
          ]
        },
        "options": {}
      },
      "id": "node-tool-pdf",
      "name": "Tool - Gerar PDF",
      "type": "@n8n/n8n-nodes-langchain.toolHttpRequest",
      "typeVersion": 1.1,
      "position": [1440, 600],
      "credentials": {
        "httpHeaderAuth": {
          "id": "apikey-cred",
          "name": "API Key Header"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const agentOutput = $input.first().json.output || '';\nconst sessionId = $('Pré-processamento').item.json.session_id;\n\n// Sanitiza saída — remove scripts\nconst cleaned = agentOutput.replace(/<script[^>]*>[\\s\\S]*?<\\/script>/gi, '').trim();\n\nconst response = cleaned || 'Não encontrei informações suficientes. Recomendo contato direto com a Implanta.';\n\n// Tenta extrair url de PDF se gerado pelo agente\nconst pdfMatch = response.match(/\\/documents\\/[\\w\\-.]+\\.pdf/);\nconst pdfUrl = pdfMatch ? pdfMatch[0] : null;\n\nreturn [{ json: { response, pdf_url: pdfUrl, session_id: sessionId, sources: [] } }];\n"
      },
